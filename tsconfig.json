{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./src/renderer/src/*"],
			"@shared/*": ["./src/shared/*"]
		},
		"types": ["node"]
	},
	"include": ["src", "electron.vite.config.ts"]
}
